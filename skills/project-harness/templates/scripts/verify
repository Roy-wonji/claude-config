#!/usr/bin/env python3
"""변경 경로에 맞는 빌드 · 테스트를 실행하고 결과를 증거로 남긴다. (.claude/docs/harness.md 검증 게이트)

사용: .claude/scripts/verify          기준 브랜치 이후 바뀐 코드에 맞는 단계만 실행
      .claude/scripts/verify --all    모든 단계 실행

- 통과하면 .claude/state/verify.json에 작업 트리 지문을 남긴다. 커밋 게이트와 종료 확인이 이 기록을 본다.
- 출력은 .claude/state/verify/{단계}.log에 저장한다. 종료 코드를 파이프로 가리지 않는다.
- 같은 단계가 2번 연속 실패하면 세 번째 시도 전에 사용자에게 보고한다.
"""
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hooks"))
import harness_state as hs  # noqa: E402

def valid_step(step):
    def str_list(v):
        return isinstance(v, list) and all(isinstance(x, str) for x in v)
    return (isinstance(step, dict) and isinstance(step.get("name"), str) and step["name"]
            and str_list(step.get("cmd")) and step["cmd"]
            and str_list(step.get("paths", []))
            and isinstance(step.get("cwd", "."), str)
            and isinstance(step.get("env", {}), dict) and all(isinstance(k, str) and isinstance(v, str) for k, v in step.get("env", {}).items())
            and isinstance(step.get("fail_if_log_matches", ""), str))


def steps_for(files, run_all):
    """.claude/harness.json 의 verify.steps 중 바뀐 경로에 해당하는 단계.

    단계: {"name", "cmd": [...], "cwd": ".", "paths": [접두 경로...], "env": {...}, "fail_if_log_matches": "정규식"}
    paths 가 비었거나 없으면 코드 변경이 있을 때 항상 실행한다.
    """
    def touched(prefixes):
        if run_all:
            return True
        if not prefixes:
            return bool(files)
        return any(f == p or f.startswith(p.rstrip("/") + "/") for f in files for p in prefixes)

    steps = []
    verify_cfg = hs.config().get("verify")
    raw = verify_cfg.get("steps") if isinstance(verify_cfg, dict) else None
    for step in raw if isinstance(raw, list) else []:
        if not valid_step(step):
            print(f"harness.json verify 단계 형식 오류, 건너뜀: {step}")
            continue
        if touched(step.get("paths", [])):
            steps.append((step["name"], step["cmd"], step.get("cwd", "."), step.get("env", {}),
                          step.get("fail_if_log_matches", "")))
    return steps


def check_log(pattern, log):
    """종료 코드 0이어도 실패로 볼 경우(예: 테스트가 SKIPPED). 이유를 돌려준다."""
    if pattern and re.search(pattern, log):
        return f"로그가 실패 패턴과 일치합니다: {pattern}"
    return ""


def main():
    root = hs.repo_root(os.getcwd())
    os.chdir(root)
    run_all = "--all" in sys.argv[1:]
    files = hs.changed_code_files(root)
    state = hs.load(root)
    failures = state.get("failures", {})

    steps = steps_for(files, run_all)
    if files and not steps:
        print("코드 변경이 있지만 .claude/harness.json 에 해당하는 verify 단계가 없습니다. 단계를 추가하세요.")
        return 1
    if not steps:
        print("검증할 코드 변경이 없습니다.")
        hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "steps": [], "failures": {}})
        return 0

    log_dir = os.path.join(hs.STATE_DIR, "verify")
    os.makedirs(log_dir, exist_ok=True)
    results = []
    for name, cmd, cwd, extra_env, fail_pattern in steps:
        log_path = os.path.join(log_dir, f"{name}.log")
        print(f"▶ {name}: {' '.join(cmd)} (로그: {log_path})", flush=True)
        started = time.monotonic()
        with open(log_path, "w", encoding="utf-8") as log_file:
            code = subprocess.run(cmd, cwd=cwd, stdout=log_file, stderr=subprocess.STDOUT,
                                  env=dict(os.environ, **extra_env)).returncode
        seconds = round(time.monotonic() - started)
        with open(log_path, encoding="utf-8", errors="replace") as log_file:
            log = log_file.read()
        reason = f"종료 코드 {code}" if code != 0 else check_log(fail_pattern, log)
        if reason:
            failures[name] = failures.get(name, 0) + 1
            print(f"✘ {name} 실패 ({seconds}초): {reason}")
            print("  마지막 로그:\n    " + "\n    ".join(log.strip().splitlines()[-15:]))
            if failures[name] >= hs.MAX_FAILURES:
                print(f"\n같은 단계({name})가 {failures[name]}번 연속 실패했습니다. "
                      "세 번째 시도 전에 시도한 내용과 실패 원인을 사용자에게 보고하고 승인을 받으세요.")
            hs.save(root, {"passed": False, "fingerprint": hs.fingerprint(root),
                           "steps": results + [{"name": name, "ok": False, "seconds": seconds, "reason": reason}],
                           "failures": failures})
            return 1
        failures.pop(name, None)
        results.append({"name": name, "ok": True, "seconds": seconds})
        print(f"✔ {name} ({seconds}초)")

    hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "steps": results, "failures": failures})
    print("검증 통과. 기록: " + hs.VERIFY_FILE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
