{
  "respectGitignore": false,
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ENABLE_TOOL_SEARCH": "true",
    "ECC_GATEGUARD": "off",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(curl:*)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "Bash(node:*)",
      "Bash(npm i)",
      "Bash(npm:*)",
      "Bash(npx eslint . --ext .ts)",
      "Bash(npx eslint src/ test/ --ext .ts --fix)",
      "Bash(npx eslint src/ test/ --ext .ts)",
      "Bash(npx:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill(keybindings-help)",
      "Skill(keybindings-help:*)",
      "Write",
      "mcp__figma",
      "mcp__context7__query-docs",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(sudo:*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ],
    "additionalDirectories": []
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-engineering.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dangerous.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-git-push.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto-format.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/type-check.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/handoff-on-failure.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/sync-skills.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "agent-council@team-attention-plugins": true,
    "swift-lsp@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "developer-kit-typescript@developer-kit": true,
    "warp@claude-code-warp": true,
    "oh-my-claudecode@omc": true,
    "superpowers@superpowers-dev": true,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "roy@roy": true,
    "apple-skills@roy": true,
    "codex@roy": true,
    "42crunch-api-security-testing@claude-plugins-official": true,
    "headroom@headroom-marketplace": true,
    "ecc@ecc": true,
    "claudex-loop@claudex-loop": true,
    "sentry@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "roy": {
      "source": {
        "source": "github",
        "repo": "Roy-wonji/claude-config"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ecc"
      }
    },
    "claude-code-plugins-marketplace": {
      "source": {
        "source": "github",
        "repo": "doodledood/claude-code-plugins"
      }
    },
    "claudex-loop": {
      "source": {
        "source": "github",
        "repo": "chaseai-yt/claudex-loop"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": true,
  "autoUploadSessions": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "switchModelsOnFlag": true
}